{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PokeTokenBar",
  "version": "0.2.2",
  "identifier": "com.tkdals2317.poketokenbar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PokeTokenBar",
        "width": 360,
        "height": 680,
        "resizable": false,
        "visible": true,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "center": true
      },
      {
        "label": "pet",
        "url": "index.html#pet",
        "title": "PokeTokenBar Pet",
        "width": 120,
        "height": 120,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA0QjM1RTYwOTM5RTJBOTUKUldTVktwNlRZRjZ6QkhaT21lcEV4T3lFYWxPTVB3ZnVqY3RaY0FQWS9xcktJQUtwcXVrNGZaekEK",
      "endpoints": [
        "https://github.com/tkdals2317/PokeTokenBar-Windows/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
